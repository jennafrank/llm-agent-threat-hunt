// D3: IMDS Access from an Interpreter, Not the Credential Helper
// ATT&CK: T1552.005 (Unsecured Credentials: Cloud Instance Metadata API)
// Data Source: LinuxNetwork_CL
// FP Assessment: The refresh credential-helper daemon is the baseline
//   (9 of 10 in-window); exclude it by process name.
// Hunt 24 — TideGlass | Jenna Frank

LinuxNetwork_CL
| where DstIpAddr == "169.254.169.254"
| where ActingProcessName != "refresh"
| project EventStartTime, Dvc, ActingProcessId, ActingProcessName
