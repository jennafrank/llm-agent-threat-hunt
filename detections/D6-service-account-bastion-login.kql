// D6: Service-Account SSH or Bastion Login from the Notebook
// ATT&CK: T1021.004 (Remote Services: SSH)
//          T1078.004 (Valid Accounts: Cloud Accounts)
// Data Source: LinuxAuth_CL
// Logic: Accepted publickey login for a service account, or any bastion
//   login sourced from the notebook host.
// FP Assessment: Confirm which service accounts and source IPs are
//   expected; deploy from the notebook host is anomalous.
// Hunt 24 — TideGlass | Jenna Frank

LinuxAuth_CL
| where DvcHostname == "gf-tg-bastion01" and EventResult == "Success"
| extend src = extract(@"from (\d+\.\d+\.\d+\.\d+)", 1, EventOriginalMessage)
| where TargetUsername in ("deploy","svc-deploy") or src == "10.6.0.10"
| project TimeGenerated, DvcHostname, TargetUsername, src, EventOriginalMessage
